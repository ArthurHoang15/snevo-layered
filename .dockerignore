# Files excluded from Docker build context.
# This is defense-in-depth in case deployment switches from buildpacks to Docker.

.git
.gitignore
.gcloudignore
.dockerignore

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

.env
*.env
local.env

.vscode/
.idea/
.cursor/
.serena/

coverage/
.nyc_output/
logs/
*.log

tmp/
temp/
uploads/
public/uploads/

frontend/assets/js/config.generated.js
frontend/pages/auth-test.html
frontend/assets/js/auth-debug.js
frontend/assets/js/auth-persistence.js
