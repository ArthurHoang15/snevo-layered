{
  "name": "snevo-layered",
  "version": "1.0.0",
  "description": "Snevo e-commerce refactor using layered architecture",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "dev:config": "node scripts/dev-config.js",
    "build": "node scripts/build.js",
    "build:frontend": "node scripts/build-frontend.js",
    "serve": "npm run build && npm start",
    "check:env": "node scripts/check-env-safety.js",
    "check:architecture": "node scripts/check-architecture.js",
    "ci": "npm run check:env && npm run check:architecture && npm test",
    "test": "node --test test/*.test.js",
    "test:backend": "node --test test/*.test.js",
    "test:frontend": "node --test test/*.test.js",
    "setup": "node scripts/setup.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "keywords": [
    "ecommerce",
    "snevo",
    "layered-architecture",
    "nodejs",
    "supabase"
  ],
  "author": "Snevo Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "sharp": "^0.34.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "fs-extra": "^11.1.1",
    "glob": "^10.3.10",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
